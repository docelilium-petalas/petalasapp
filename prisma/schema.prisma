datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

// ENUMS
enum AppRole {
  ADMIN
  MODERATOR
  USER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealPriority {
  ALTA
  MEDIA
  BAIXA
  NAO_RESPONDEU
}

enum LeadStatus {
  ATIVO
  ADD_LISTA
  DISPARADO
  DESCARTADO
}

enum StatusEnvio {
  PENDENTE
  ENVIANDO
  ENVIADO
  ERRO
}

enum ListaDisparoStatus {
  AGENDADA
  ATIVA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum AcaoStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum ActivityStatus {
  OPEN
  DONE
  CANCELLED
}

enum ProcessamentoStatus {
  PROCESSANDO
  CONCLUIDO
  ERRO
}

enum GoogleLeadStatus {
  NOVO
  IMPORTADO
  DESCARTADO
}

// MODELS

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  profile      Profile?
  roles        UserRole[]
  permissions  UserFeaturePermission[]
  teamMembers  TeamMember[]
  pipelines    Pipeline[]
  desafioCustos     DesafioCusto[]
  desafioMetas      DesafioMeta[]
  desafioChallenges DesafioChallenge[]
  contacts     Contact[]          @relation("UserContacts")
  ownedContacts Contact[]         @relation("OwnerContacts")
  deals        Deal[]             @relation("UserDeals")
  ownedDeals   Deal[]             @relation("OwnerDeals")
  activities   Activity[]         @relation("UserActivities")
  ownedActivities Activity[]      @relation("OwnerActivities")
  leads        Lead[]             @relation("UserLeads")
  ownedLeads   Lead[]             @relation("OwnerLeads")
  leadsCnpj    LeadCnpj[]
  buscaMaps    HistoricoBuscas[]
  buscaCnpj    HistoricoBuscasCnpj[]
  listas       ListaDisparo[]     @relation("UserListas")
  ownedListas  ListaDisparo[]     @relation("OwnerListas")
  acoes        AcaoCaixaRapido[]
  webhooks     Webhook[]
  templates    MessageTemplate[]
  cadencias    Cadencia[]
  segmentos    Segmento[]
  tracking     TrackingEvent[]
  integrations Integration[]
  aiConfigs    AiAgentConfig[]
  googleLeads  GoogleLead[]
  niches       Niche[]
}

model Profile {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                       String
  sobrenome                  String
  avatarUrl                  String?
  telefone                   String?
  leadSearchWebhookUrl       String?
  cnpjSearchWebhookUrl       String?
  disparoWebhookUrl          String?
  disparoStatusWebhookUrl    String?
  disparoCancelarWebhookUrl String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Team {
  id        String       @id @default(uuid())
  nome      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]
  pipelines Pipeline[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AppRole  @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AppRole  @default(USER)
  createdAt DateTime @default(now())

  @@unique([userId, role])
}

model UserFeaturePermission {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, feature])
}

model Pipeline {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  nome      String
  isDefault Boolean  @default(false)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stages    Stage[]
  deals     Deal[]
}

model Stage {
  id             String             @id @default(uuid())
  pipelineId     String
  pipeline       Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  nome           String
  cor            String
  ordem          Int                @default(0)
  probabilidade  Int                @default(0)
  slaHours       Int                @default(24)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deals          Deal[]
  historyFrom    DealStageHistory[] @relation("DeStage")
  historyTo      DealStageHistory[] @relation("ParaStage")
}

model Contact {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  ownerUserId        String?
  ownerUser          User?           @relation("OwnerContacts", fields: [ownerUserId], references: [id])
  nome               String
  sobrenome          String?
  email              String?
  telefone           String
  documento          String?
  cidade             String?
  estado             String?
  tags               String?         // Armazenado como string JSON ou texto
  camposCustomizados String?         // String JSON
  fbMetadata         String?         // String JSON
  firstUtmSource     String?
  firstUtmMedium     String?
  firstUtmCampaign   String?
  firstUtmContent    String?
  firstUtmTerm       String?
  firstLandingPage   String?
  firstReferrerUrl   String?
  firstUtmAt         DateTime?
  lastUtmSource      String?
  lastUtmMedium      String?
  lastUtmCampaign    String?
  lastUtmContent     String?
  lastUtmTerm        String?
  lastLandingPage    String?
  lastReferrerUrl    String?
  lastUtmAt          DateTime?
  enderecoCompleto   String?
  consentimentoLgpd  Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deals              Deal[]
  activities         Activity[]
  trackingEvents     TrackingEvent[]
  cadenciaLeads      CadenciaLead[]
}

model Deal {
  id                      String          @id @default(uuid())
  pipelineId              String
  pipeline                Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId                 String
  stage                   Stage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId               String
  contact                 Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User            @relation("UserDeals", fields: [userId], references: [id], onDelete: Cascade)
  ownerUserId             String?
  ownerUser               User?           @relation("OwnerDeals", fields: [ownerUserId], references: [id])
  titulo                  String
  valorEstimado           Float           @default(0.0)
  produtoInteresse        String?
  origem                  String?
  prioridade              DealPriority    @default(MEDIA)
  status                  DealStatus      @default(OPEN)
  motivoPerda             String?
  fechadoEm               DateTime?
  telefone                String?
  ramoEmpresa             String?
  faturamentoMensal       Float           @default(0.0)
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmContent              String?
  utmTerm                 String?
  utmLandingPage          String?
  utmReferrer             String?
  utmCapturedAt           DateTime?
  tags                    String?         // String JSON — ex: ["em-cadencia-leads-perdidos","vip"]
  anotacoes               String?
  anotacoesReuniao        String?
  aiScore                 Int             @default(0)
  aiScoreFactors          String?         // String JSON
  aiAnalysis              String?
  aiAnalyzedAt            DateTime?
  aiRecommendedAction     String?
  aiSessionId             String?
  qualificationStatus     String?
  qualificationData       String?         // String JSON
  disqualificationReason  String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  activities              Activity[]
  stageHistory            DealStageHistory[]
  leadsListaDisparo       LeadListaDisparo[]
  aiSessions              AiQualificationSession[]
  cadenciaLeads           CadenciaLead[]
}

model Activity {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  ownerUserId String?
  ownerUser   User?          @relation("OwnerActivities", fields: [ownerUserId], references: [id])
  dealId      String?
  deal        Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tipo        String         // ligacao, reuniao, tarefa, nota, WhatsApp, email
  titulo      String
  descricao   String?
  dueAt       DateTime?
  status      ActivityStatus @default(OPEN)
  doneAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model DealStageHistory {
  id           String   @id @default(uuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deStageId    String?
  deStage      Stage?   @relation("DeStage", fields: [deStageId], references: [id])
  paraStageId  String
  paraStage    Stage    @relation("ParaStage", fields: [paraStageId], references: [id])
  mudouEm      DateTime @default(now())
  mudouPor     String
  fonte        String   // kanban_drag, menu, bulk, api, ai
}

model Lead {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserLeads", fields: [userId], references: [id], onDelete: Cascade)
  ownerUserId String?
  ownerUser   User?    @relation("OwnerLeads", fields: [ownerUserId], references: [id])
  nome        String
  nicho       String?
  cidade      String?
  estado      String?
  telefone    String
  site        String?
  endereco    String?
  avaliacao   Float    @default(0.0)
  status      String   @default("ativo") // ativo, add_lista, disparado, descartado
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cadenciaLeads CadenciaLead[]
}

model LeadCnpj {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnpj          String   @unique
  cnaeCodigo    String?
  cnaeDescricao String?
  situacao      String?
  dataAbertura  String?
  cidade        String?
  estado        String?
  email         String?
  telefone      String?
  nome          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HistoricoBuscas {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicho              String
  cidade             String
  estado             String
  quantidade         Int      @default(0)
  statusProcessamento String   @default("processando") // processando, concluido, erro
  payload            String?  // String JSON
  erro               String?
  createdAt          DateTime @default(now())
}

model HistoricoBuscasCnpj {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnaeCodigo         String
  cidade             String
  estado             String
  statusProcessamento String   @default("processando")
  payload            String?  // String JSON
  erro               String?
  createdAt          DateTime @default(now())
}

model AcaoCaixaRapido {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  cadenciaId  String?     @map("cadencia_id")
  status      AcaoStatus  @default(ATIVA)
  totalEtapas Int         @default(0)
  totalLeads  Int         @default(0)
  configEnvio String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  listas      ListaDisparo[]

  @@map("acoes_caixa_rapido")
}

model Webhook {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhooks")
}

model ListaDisparo {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation("UserListas", fields: [userId], references: [id], onDelete: Cascade)
  ownerUserId      String?
  ownerUser        User?              @relation("OwnerListas", fields: [ownerUserId], references: [id])
  acaoId           String?            @map("acao_id")
  acao             AcaoCaixaRapido?   @relation(fields: [acaoId], references: [id], onDelete: Cascade)
  etapaNumero      Int?               @map("etapa_numero")
  dataAgendamento  DateTime?          @map("data_agendamento")
  nomeLista        String
  descricao        String?
  mensagemTemplate String
  status           ListaDisparoStatus @default(ATIVA)
  totalLeads       Int                @default(0)
  enviados         Int                @default(0)
  erros            Int                @default(0)
  configEnvio      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  leads            LeadListaDisparo[]
  historico        HistoricoDisparos[]
}

model LeadListaDisparo {
  id               String            @id @default(uuid())
  listaId          String
  lista            ListaDisparo      @relation(fields: [listaId], references: [id], onDelete: Cascade)
  leadId           String?
  leadCnpjId       String?
  dealId           String?
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  nomeSnapshot     String
  telefoneSnapshot String
  mensagemFinal    String
  statusEnvio      StatusEnvio       @default(PENDENTE)
  tentativas       Int               @default(0)
  mensagemErro     String?
  dataEnvio        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  disparos         HistoricoDisparos[]
}

model HistoricoDisparos {
  id             String           @id @default(uuid())
  listaId        String
  lista          ListaDisparo     @relation(fields: [listaId], references: [id], onDelete: Cascade)
  leadListaId    String
  leadLista      LeadListaDisparo @relation(fields: [leadListaId], references: [id], onDelete: Cascade)
  telefone       String
  nome           String
  status         String           // enviado, erro, etc.
  tempoRespostaMs Int             @default(0)
  erro           String?
  payload        String?          // String JSON
  createdAt      DateTime         @default(now())
}

model MessageTemplate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  categoria String   // Sondagem / Follow-up / Recuperação / Reativação / Personalizado
  corpo     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

model Cadencia {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome       String
  tipo       String   // Follow-up / Recuperação / Reativação
  webhookUrl String?  @map("webhook_url")
  pipelineId String?  @map("pipeline_id")
  status     String   @default("ATIVO") // ATIVO / PAUSADO
  tipoOrigem String?  @default("personalizada") @map("tipo_origem") // 'template', 'personalizada'
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  etapas     CadenciaEtapa[]
  leads      CadenciaLead[]

  @@map("cadencias")
}

model CadenciaEtapa {
  id          String   @id @default(uuid())
  cadenciaId  String   @map("cadencia_id")
  cadencia    Cadencia @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)
  ordem       Int
  prazoValor  Int      @map("prazo_valor")
  prazoUnidade String  @map("prazo_unidade") // horas / dias / semanas
  mensagem    String   @db.Text
  templateId  String?  @map("template_id")
  pararAoResponder Boolean @default(true) @map("parar_ao_responder")

  @@map("cadencia_etapas")
}

model CadenciaLead {
  id          String   @id @default(uuid())
  cadenciaId  String   @map("cadencia_id")
  cadencia    Cadencia @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)
  leadId      String?  @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id])
  dealId      String?  @map("deal_id")
  deal        Deal?    @relation(fields: [dealId], references: [id])
  contactId   String?  @map("contact_id")
  contact     Contact? @relation(fields: [contactId], references: [id])
  etapaAtual  Int      @default(1) @map("etapa_atual")
  status      String   @default("ATIVO") // ATIVO, CONCLUIDA, RESPONDIDA
  proximoEnvio DateTime? @map("proximo_envio")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cadencia_leads")
}

model TrackingEvent {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceSystem   String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  landingPage    String?
  referrerUrl    String?
  ipAddress      String?
  userAgent      String?
  payloadRaw     String?   // String JSON
  createdAt      DateTime  @default(now())
}

model Integration {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String   // n8n, Meta, Evolution, Elementor, etc.
  authType  String?
  baseUrl   String?
  settings  String?  // String JSON
  secrets   String?  // String JSON
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiAgentConfig {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome                     String
  nomeExibicao             String
  tomComunicacao           String
  promptSistema            String
  promptQualificacao       String
  promptObjecoes           String
  scriptAbertura           String
  scriptQualificacao       String
  scriptFechamentoPositivo String
  scriptFechamentoNegativo String
  criterios                String?  // BANT ou outros
  acoesQualificado         String?  // Mover etapa, webhook, etc.
  acoesDesqualificado      String?
  modeloIa                 String   @default("gpt-4o")
  temperatura              Float    @default(0.7)
  maxTokens                Int      @default(1000)
  emojisPermitidos         Boolean  @default(true)
  evolutionInstanceId      String?
  n8nWebhookUrl            String?
  webhookSecret            String?
  ativo                    Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AiQualificationSession {
  id                 String                @id @default(uuid())
  dealId             String
  deal               Deal                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sessionId          String                @unique
  startedAt          DateTime              @default(now())
  lastInteractionAt  DateTime              @default(now())
  completedAt        DateTime?
  mensagensEnviadas  Int                   @default(0)
  mensagensRecebidas Int                   @default(0)
  scoreInicial       Int                   @default(0)
  scoreFinal         Int                   @default(0)
  qualificationResult String?               // qualificado, desqualificado, em_andamento
  tempoTotalMinutos  Int                   @default(0)
  createdAt          DateTime              @default(now())
  logs               AiConversationLog[]
}

model AiConversationLog {
  id        String                 @id @default(uuid())
  sessionId String
  session   AiQualificationSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  dealId    String
  role      String                 // user, assistant, system
  content   String
  metadata  String?                // String JSON
  createdAt DateTime               @default(now())
}

model Segmento {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome       String
  descricao  String?
  prioridade String?  // 'maxima', 'media', 'baixa'
  tipo       String   @default("personalizado") // 'template', 'personalizado'
  filtros    String   @db.Text // JSON: SegmentoRegra[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("segmentos")
}

model EventIngestLog {
  id        String   @id @default(uuid())
  source    String
  payload   String?  // String JSON
  status    String
  error     String?
  createdAt DateTime @default(now())
}

// Generic key-value config per user (stores segmentos rules, preferences, etc.)
model UserConfig {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String   // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model SystemSetting {
  id        String   @id @default(uuid())
  chave     String   @unique
  valor     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model GoogleLead {
  id              String             @id @default(dbgenerated("gen_random_uuid()"))
  userId          String
  nome            String?
  telefone        String?
  endereco        String?
  cidade          String?
  uf              String?
  nicho           String?
  site            String?
  dataBusca       DateTime           @default(now())
  status          GoogleLeadStatus   @default(NOVO)
  notas           String?
  importedToCrm   Boolean            @default(false)
  importedAt      DateTime?
  crmContactId    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([cidade])
  @@index([uf])
  @@index([nicho])

  @@map("google_leads")
}

model Niche {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  categoria   String   @default("PROSPECCAO")
  status      String   @default("ativo")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nome, userId])
  @@index([userId])

  @@map("niches")
}

model N8nChatHistory {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id")
  message   Json     @map("message")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("n8n_chat_histories")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÁQUINA DE VENDAS
// ═══════════════════════════════════════════════════════════════════════════
//
// Desenho mesclado a partir de duas implementações que já rodaram em produção
// — a da OCR e a da CarBoss — e adaptado para e-commerce de moda.
// O que veio de cada uma está em docs/n8n/REFERENCIA-MAQUINA-VENDAS.md.
//
// Os três conflitos que precisaram de decisão:
//
//   1. `reuniaoEm` na CarBoss servia de âncora E de desfecho, e escrever o
//      desfecho sobrescrevia a âncora — a copy passava a citar a data errada.
//      Aqui são campos separados: `ancoraEm` nunca é reescrito.
//   2. Nomenclatura do erro da Meta: vale a da OCR (`codigoErro`,
//      `naturezaFalha`), com o `falhaMotivo` da CarBoss entrando ao lado.
//   3. Ajustes operacionais: a OCR guardava em `system_settings`, a CarBoss
//      numa tabela própria com tela. Fica a tabela — é o que a tela edita.
//
// ── A ADAPTAÇÃO QUE MUDA O MÓDULO ─────────────────────────────────────────
// Nas duas origens a Máquina dispara por "card parado na coluna X" — venda
// consultiva B2B. A Doce Lilium vende roupa: o gatilho natural é carrinho
// abandonado, pedido pago, entrega e recompra. Por isso a inscrição não é
// mais só de um Deal — ela tem ORIGEM e referência externa.

model MvCadencia {
  id      String @id @default(uuid())
  nome    String
  /// carrinho_abandonado | pedido_pago | pos_entrega | reativacao | nao_agendou
  gatilho String

  /// Só para o gatilho de funil (`nao_agendou`). Nulo nos gatilhos de loja,
  /// que não têm coluna nenhuma para observar.
  pipelineId String? @map("pipeline_id")
  stageId    String? @map("stage_id")

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  etapas     MvCadenciaEtapa[]
  inscricoes MvInscricao[]

  @@unique([gatilho, pipelineId, stageId])
  @@index([ativo, gatilho])
  @@map("maquina_vendas_cadencias")
}

model MvCadenciaEtapa {
  id         String @id @default(uuid())
  cadenciaId String @map("cadencia_id")
  ordem      Int

  /// Minutos após a ÂNCORA. Para carrinho abandonado o relógio conta do
  /// `created_at` do checkout na Nuvemshop, nunca do instante em que a
  /// varredura o encontrou — o registro pode demorar até 6h para aparecer.
  delayMinutos Int    @map("delay_minutos")
  /// gatilho | entrega — de onde o relógio conta.
  ancoradaEm   String @default("gatilho") @map("ancorada_em")

  /// Esqueleto com {{primeiro_nome}}, {{peca}}, {{pedido}}, {{cupom}}...
  templateBase String  @map("template_base")
  /// Nome do template aprovado na Meta, quando o envio sai por template.
  /// Nulo = texto livre, só válido dentro da janela de 24h.
  templateNome String? @map("template_nome")
  /// A última se anuncia como última. Sem isso a régua vira perseguição.
  ehUltima     Boolean @default(false) @map("eh_ultima")

  cadencia MvCadencia @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)

  @@unique([cadenciaId, ordem])
  @@map("maquina_vendas_cadencia_etapas")
}

model MvInscricao {
  id         String @id @default(uuid())
  cadenciaId String @map("cadencia_id")

  /// De onde veio: `carrinho` | `pedido` | `pipeline`.
  origem String
  /// A chave no sistema de origem — token do checkout, id do pedido, ou o
  /// dealId. Sem FK de propósito: carrinho e pedido vivem na Nuvemshop.
  refExterna String  @map("ref_externa")
  dealId     String? @map("deal_id")
  contactId  String? @map("contact_id")

  nomeSnapshot String @map("nome_snapshot")
  telefoneE164 String @map("telefone_e164")
  /// Últimos 8 dígitos. É a chave que casa loja, CRM e conversa do WhatsApp —
  /// medido: 36 dos 56 contatos têm 12 dígitos, sem o 9º.
  telefoneKey  String @map("telefone_key")

  /// Menor sai primeiro. 0 = já comprou alguma vez; 1 = primeira interação.
  prioridade Int @default(1)

  /// ATIVA | PAUSADA | CONCLUIDA | RESPONDEU | CONVERTEU | CANCELADA | ERRO
  /// | OPT_OUT | NUMERO_INVALIDO | BLOQUEADA_META
  status       String  @default("ATIVA")
  motivoParada String? @map("motivo_parada")
  tentativas   Int     @default(0)

  /// ── ÂNCORA (entrada) ───────────────────────────────────────────────────
  /// O instante do evento que originou a inscrição, no relógio da FONTE.
  /// Nunca sobrescrever: é dele que todas as etapas contam.
  ancoraEm DateTime @map("ancora_em")
  /// Retrato do que estava no carrinho ou no pedido, para a copy citar sem
  /// consultar a loja de novo — e para o texto não mudar se o carrinho mudar.
  contexto Json?

  /// ── DESFECHOS (saída) ──────────────────────────────────────────────────
  /// Instante da última fala do lead depois do nosso envio. Substitui
  /// `status = 'RESPONDEU'` como fonte: o status só é escrito quando responder
  /// ENCERRA a cadência, e no dia em que passar a só adiar o contador congela
  /// em zero sem avisar. Foi o defeito medido nos dois projetos de origem.
  respondeuEm DateTime? @map("respondeu_em")
  respostas   Int       @default(0)
  /// Um humano do time entrou na conversa. Fica NULL até haver fonte que
  /// distinga agente de pessoa — o webhook da Meta não distingue.
  humanoFalouEm DateTime? @map("humano_falou_em")
  /// O carrinho virou pedido, ou o pedido foi pago, dentro da janela.
  converteuEm     DateTime? @map("converteu_em")
  valorConvertido Decimal?  @map("valor_convertido") @db.Decimal(12, 2)

  /// Marcação manual do operador: CONTATO_ERRADO | DESCONSIDERAR. Ganha de
  /// todos os sinais automáticos — quem abriu a conversa sabe mais que a
  /// heurística. Desfazer é gravar NULL nos três.
  resultadoManual    String?   @map("resultado_manual")
  resultadoManualEm  DateTime? @map("resultado_manual_em")
  resultadoManualPor String?   @map("resultado_manual_por")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cadencia  MvCadencia   @relation(fields: [cadenciaId], references: [id])
  mensagens MvMensagem[]

  /// Idempotência da inscrição: o mesmo carrinho não entra duas vezes na mesma
  /// cadência. É o que torna a varredura segura para reprocessar — e a
  /// varredura é obrigatória, porque a Nuvemshop não publica webhook de carrinho.
  @@unique([cadenciaId, origem, refExterna])
  @@index([status])
  @@index([telefoneKey])
  @@index([respondeuEm])
  @@map("maquina_vendas_inscricoes")
}

model MvMensagem {
  id          String @id @default(uuid())
  inscricaoId String @map("inscricao_id")
  etapaOrdem  Int    @map("etapa_ordem")

  /// A copy final, congelada na semeadura. A tabela mostra exatamente o texto
  /// que sai — por isso nenhum LLM reescreve nada no caminho do disparo.
  mensagemFinal String   @map("mensagem_final")
  agendadaPara  DateTime @map("agendada_para")

  /// AGENDADA | ENVIADA | CANCELADA | PULADA | VETADA | ERRO
  status          String    @default("AGENDADA")
  enviadaEm       DateTime? @map("enviada_em")
  erro            String?
  tentativasEnvio Int       @default(0) @map("tentativas_envio")
  payloadEnvio    String?   @map("payload_envio")

  /// ── Confirmação do canal ───────────────────────────────────────────────
  /// `enviadaEm` sempre significou "a API aceitou e devolveu um id", nunca
  /// "chegou". Os campos abaixo é que dizem.
  idExterno  String?   @map("id_externo")
  entregueEm DateTime? @map("entregue_em")
  lidaEm     DateTime? @map("lida_em")
  /// Código numérico da Meta (131026, 131047, 132001...). Número, e não texto:
  /// número não tem sinônimo, e é ele que decide re-tentar × desistir.
  codigoErro Int?      @map("codigo_erro")
  falhaMotivo String?  @map("falha_motivo")
  /// NUMERO_INVALIDO | BLOQUEADA_META | JANELA_FECHADA | CANAL_FORA |
  /// CONFIGURACAO | DESCONHECIDA. Gravado no momento da falha porque a tabela
  /// de códigos muda: reclassificar o passado com a tabela de hoje reescreveria
  /// a história.
  naturezaFalha String? @map("natureza_falha")
  templateNome  String? @map("template_nome")
  /// `oficial` (Meta/Datafy) ou `nao_oficial` (uazapi). Mantido para o
  /// histórico anterior a uma migração de canal não virar mentira retroativa.
  canal         String  @default("nao_oficial")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inscricao MvInscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@index([status, agendadaPara])
  @@index([idExterno])
  @@map("maquina_vendas_mensagens")
}

model MvCursor {
  id        String   @id @default(uuid())
  chave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("maquina_vendas_cursor")
}

model MvResposta {
  /// Sufixo de 8 dígitos do telefone. O `session_id` do WhatsApp às vezes vem
  /// sem o 9º dígito, então igualdade exata perderia a resposta de quem
  /// respondeu — e enviar para quem já respondeu é como se queima um número.
  telefoneKey  String   @id @map("telefone_key")
  telefoneE164 String?  @map("telefone_e164")
  /// Instante da última mensagem escrita PELO LEAD — nunca o eco do disparo.
  respondidoEm DateTime @map("respondido_em")
  ultimasMsgs  Json?    @map("ultimas_msgs")
  origem       String   @default("n8n")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([respondidoEm])
  @@map("maquina_vendas_respostas")
}

model MvOptOut {
  /// Mesma chave de 8 dígitos, pelo mesmo motivo.
  telefoneKey  String    @id @map("telefone_key")
  telefoneE164 String?   @map("telefone_e164")
  /// `botao` | `texto` | `manual` | `meta` — de onde veio a negativa.
  origem       String    @default("texto")
  /// A frase exata que a pessoa escreveu. É o que permite auditar um falso
  /// positivo do detector sem abrir a conversa.
  trecho       String?
  despedidaEm  DateTime? @map("despedida_em")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("maquina_vendas_opt_out")
}

model MvAjustes {
  /// Linha única. Os números que a operação muda olhando o relógio — sem deploy,
  /// porque um parâmetro ajustado às 9h de um dia de disparo não pode custar
  /// um deploy manual no EasyPanel.
  id String @id @default("unico")

  tetoDiario          Int @default(40) @map("teto_diario")
  intervaloMinMinutos Int @default(3) @map("intervalo_min_minutos")
  intervaloMaxMinutos Int @default(12) @map("intervalo_max_minutos")
  /// Janela de envio na parede de São Paulo, em "HH:mm".
  janelaInicio String @default("09:00") @map("janela_inicio")
  janelaFim    String @default("20:00") @map("janela_fim")
  /// Desligar sem apagar cadência. NASCE PAUSADO de propósito: a Máquina não
  /// deve começar a falar com cliente real por causa de um deploy.
  envioPausado Boolean @default(true) @map("envio_pausado")

  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  atualizadoPor String?  @map("atualizado_por")

  @@map("maquina_vendas_ajustes")
}

model LogEvento {
  id     String @id @default(uuid())
  /// Nome do workflow n8n, ou "crm".
  origem String
  /// INFO | AVISO | ERRO — só existe nível que a tela filtra.
  nivel  String @default("INFO")
  /// Slug estável para agrupar: envio_falhou, orcamento, carrinho_novo...
  tipo   String

  titulo  String
  detalhe String? @db.Text
  dados   String? @db.Text

  lidoEm    DateTime? @map("lido_em")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([nivel, createdAt])
  @@map("logs_eventos")
}

// ═══════════════════════════════════════════════════════════════════════════
// DESAFIOS — metas e campanhas
// ═══════════════════════════════════════════════════════════════════════════
// Portado da OCR. Numa loja de roupa a meta e o coracao da operacao de
// vendas: e o que transforma "vendemos" em "vendemos o suficiente".

model DesafioCusto {
  id        String   @id @default(uuid())
  userId    String
  mesAno    String
  valor     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mesAno])
  @@map("desafio_custos")
}

model DesafioMeta {
  id          String   @id @default(uuid())
  userId      String
  periodo     String
  metrica     String
  alvo        Float
  tipo        String   @default("MAIOR_MELHOR")
  ownerUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodo, metrica, ownerUserId])
  @@index([userId, periodo])
  @@map("desafio_metas")
}

model DesafioChallenge {
  id          String   @id @default(uuid())
  userId      String
  titulo      String
  descricao   String?
  metrica     String
  alvo        Float
  inicio      DateTime
  fim         DateTime
  recompensa  String?
  ownerUserId String?
  status      String   @default("ATIVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("desafio_challenges")
}
